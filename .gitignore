# Secrets and environment files
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# Local databases
*.db
*.sqlite
*.sqlite3

# Caches
__pycache__/
*.py[cod]
.ruff_cache/
.mypy_cache/
.pytest_cache/

# Tool state — the agent's own caches, never project content
.atl/


# Build artifacts
build/
dist/
*.egg-info/

# Virtualenvs
# The project owns its interpreter; it lives inside the tree and is never committed.
.venv/
venv/

# Model assets — inputs, never committed
model/assets/
*.safetensors
*.pth
*.gguf

# Server state
run/

# Test evidence — run products are never committed; the READMEs beside them are
tests/**/evidence/**
!tests/**/evidence/**/
!tests/**/evidence/**/README.md

# Default output
out/

# Logs
*.log
logs/
